ANTHROPIC_API_KEY=
SWARM_MODEL=claude-sonnet-5-5
# auto = API si hay ANTHROPIC_API_KEY, si no la CLI `claude -p` (sin API key, usa tu login de Claude Code)
LLM_BACKEND=auto

# Seguridad: por defecto NADA se publica de verdad
DRY_RUN=true
REQUIRE_APPROVAL=true

# Instagram Graph API (cuenta Business/Creator vinculada a una página de Facebook)
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v21.0

# Límite de publicaciones por día (tope duro de la API: 100)
MAX_POSTS_PER_DAY=2

# Imágenes (Black Forest Labs / FLUX) — https://docs.bfl.ai
BFL_API_KEY=
BFL_MODEL=flux-pro-1.1

# Hosting público para que Instagram pueda leer las imágenes: local | cloudinary
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
