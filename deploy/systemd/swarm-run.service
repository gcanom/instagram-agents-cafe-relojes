[Unit]
Description=Instagram swarm: generar post (si hace falta) y publicar aprobados
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SVC_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/instagram-swarm.env
# flock evita que este ciclo y el de publish corran a la vez
ExecStart=/usr/bin/flock -n @APP_DIR@/data/swarm.lock @APP_DIR@/.venv/bin/python -m swarm.cli run
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
